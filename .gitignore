# Raw source documents — large, and re-retrievable from USPTO / archive.org.
# Provenance lives in the extracted rows (source id + offsets), not in these files.
corpus/raw/
# NB patent-ids.json is NOT ignored — it is the expensive, fragile artifact
# (discovery is rate-limited and cannot be casually re-run). It stays in git.
corpus/staging/

.DS_Store
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# --- secrets & host details: pre-emptive, nothing matches today ---
# This repo is intended to become public when the corpus ships CC0, and git history
# is permanent. Keep anything that would need scrubbing out from the first commit.
config.json
*.pem
*.key
id_rsa*
id_ed25519*
.env
.env.*
secrets.*
# Held-out labelling: the KEY must never be committed before labelling is done,
# and the labelled set is evidence — commit that deliberately, not by accident.
pipeline/heldout-key.json
